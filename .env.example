FLOWFORGE_MAIL=mock
# For real Gmail: FLOWFORGE_MAIL=gmail
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Default is redirect (safe for testing). To mail the actual lead: GMAIL_DELIVER=live
# GMAIL_REDIRECT_TO=you@gmail.com
# GMAIL_DELIVER=redirect
# Google Sheet (Share -> Anyone with the link, Viewer). An edit URL works too.
# SHEETS_CSV_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit?gid=0
# Demo follow-up wait in ms. The recipe stays P3D; 60000 = 1 minute.
# FLOWFORGE_FOLLOWUP_MS=60000
# Agent loop: sheet sync + due follow-ups (default 15s). off = disabled.
# FLOWFORGE_LOOP_MS=15000
# Discount ceiling in percent. A row above this is blocked.
# FLOWFORGE_MAX_DISCOUNT=20
# AI compiler + email drafts. Without a key, rules and templates are used.
# Groq (free tier) — this is what makes the agent write the emails:
# FLOWFORGE_LLM_KEY=gsk_...
# FLOWFORGE_LLM_BASE_URL=https://api.groq.com/openai/v1
# FLOWFORGE_LLM_MODEL=openai/gpt-oss-20b
# OpenAI (paid):
# FLOWFORGE_LLM_KEY=sk-...
# FLOWFORGE_LLM_MODEL=gpt-4o-mini
